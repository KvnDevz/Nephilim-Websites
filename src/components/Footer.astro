---
import { CheckCircle2 } from "lucide-react";
---

<footer class="w-full bg-[#0c0c0c] text-[12px] text-[#8e8c87]">
  <div class="mx-auto max-w-[1360px] border-x border-[#222222]">
    <div class="grid grid-cols-1 md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-[#222222] border-b border-[#222222]">
      <!-- Col 1: Brand & Clean-Room Statement (6 cols) -->
      <div class="md:col-span-6 p-6 sm:p-10 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="grid h-6 w-6 place-items-center border border-[#2a2a2a] bg-[#181818]">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1.5" y="2.5" width="5" height="3" fill="#88c0d0" />
              <rect x="9.5" y="2.5" width="5" height="3" fill="#88c0d0" />
              <rect x="1.5" y="10.5" width="5" height="3" fill="#a3be8c" />
              <rect x="9.5" y="10.5" width="5" height="3" fill="#a3be8c" />
              <path d="M8 1.5v13" stroke="#e06c75" stroke-width="1.6" />
            </svg>
          </div>
          <span class="text-[14px] font-bold text-[#f0efeb]">AirCut</span>
          <span class="num border border-[#2a2a2a] bg-[#141414] px-1.5 py-0.5 text-[10.5px] text-[#a3be8c]">
            v1.0.0 x86_64
          </span>
        </div>

        <p class="max-w-[54ch] text-[12.5px] leading-relaxed text-[#c8c6c1]">
          Deterministic Layer-2 traffic shaping and autonomous ARP governance engine for Windows workstations. Built with Rust, Tauri v2, and direct WinPcap 4.1.3 NPF ring-0 bindings.
        </p>

        <p class="max-w-[54ch] text-[11.5px] leading-relaxed text-[#8e8c87]">
          100% clean-room original implementation. All Rust FFI structures, UI systems, and visual tokens are authored independently.
        </p>
      </div>

      <!-- Col 2: Direct Artifact Links (3 cols) -->
      <div class="md:col-span-3 p-6 sm:p-10 space-y-3">
        <div class="text-[11.5px] font-bold text-[#f0efeb]">RELEASE BINARIES</div>
        <ul class="space-y-2 text-[12px]">
          <li>
            <a
              href="/downloads/AirCut_1.0.0_x64-setup.exe"
              download
              class="hover:text-[#a3be8c] transition-colors"
            >
              AirCut_1.0.0_x64-setup.exe (1.92 MB)
            </a>
          </li>
          <li>
            <a
              href="/downloads/AirCut_1.0.0_portable.exe"
              download
              class="hover:text-[#a3be8c] transition-colors"
            >
              AirCut_1.0.0_portable.exe (7.10 MB)
            </a>
          </li>
          <li>
            <a
              href="https://www.winpcap.org/install/"
              target="_blank"
              rel="noreferrer"
              class="hover:text-[#88c0d0] transition-colors"
            >
              WinPcap 4.1.3 Driver Prerequisite
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Section Index (3 cols) -->
      <div class="md:col-span-3 p-6 sm:p-10 space-y-3">
        <div class="text-[11.5px] font-bold text-[#f0efeb]">INSTRUMENTATION INDEX</div>
        <ul class="space-y-2 text-[12px]">
          <li>
            <a href="#workbench" class="hover:text-[#f0efeb] transition-colors">
              Interactive Zero-Shift Workbench
            </a>
          </li>
          <li>
            <a href="#architecture" class="hover:text-[#f0efeb] transition-colors">
              NPF Kernel Ring Architecture
            </a>
          </li>
          <li>
            <a href="#anatomy" class="hover:text-[#f0efeb] transition-colors">
              42-Octet Frame Dissector
            </a>
          </li>
          <li>
            <a href="#benchmark" class="hover:text-[#f0efeb] transition-colors">
              Benchmark Comparison Matrix
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Colophon Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 px-6 py-4 text-[11px] text-[#8e8c87]">
      <div>
        &copy; {new Date().getFullYear()} AirCut Project. Engineered for network administrators and security researchers.
      </div>
      <div class="flex items-center gap-2 text-[#a3be8c]">
        <CheckCircle2 size={13} />
        <span class="num">SHA-256 VERIFIED · ZERO TELEMETRY</span>
      </div>
    </div>
  </div>
</footer>
