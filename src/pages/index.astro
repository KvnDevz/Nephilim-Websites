---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TelemetrySpecs from "../components/TelemetrySpecs.astro";
import PacketAnatomy from "../components/PacketAnatomy.astro";
import ComparisonMatrix from "../components/ComparisonMatrix.astro";
import { DownloadHub } from "../components/islands/DownloadHub";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Nephilim — Deterministic L2 Traffic Shaper & ARP Governance Engine"
  description="Pure Rust + Tauri v2 native packet engine over WinPcap 4.1.3. Sub-millisecond Layer 2 ARP inspection, zero-shift bandwidth throttling, and autonomous ARP table defense."
>
  <Header />
  <main>
    <Hero />
    <TelemetrySpecs />
    <PacketAnatomy />
    <ComparisonMatrix />
    <DownloadHub client:visible />
  </main>
  <Footer />
</Layout>
